PORT=3000

# Segredo usado para assinar os tokens JWT. Troque por um valor aleatório forte em produção.
JWT_SECRET=troque-por-um-segredo-forte

# E-mails que se tornam administrador automaticamente ao se cadastrar (ou logar).
# Separe múltiplos e-mails por vírgula. Sem esta variável, o padrão é weily@unemat.br.
ADMIN_EMAILS=weily@unemat.br

# Origem(ns) permitida(s) por CORS, separadas por vírgula (ex.: https://seusite.com).
# Deixe em branco se o frontend for servido pelo próprio backend (recomendado) —
# nesse caso CORS cross-origin fica desabilitado por padrão, o que é mais seguro.
CORS_ORIGIN=

# Coloque "true" quando o app rodar atrás de um proxy/load balancer com TLS
# (a maioria dos hosts) para forçar redirecionamento de http para https.
FORCE_HTTPS=false

# URL pública do site, usada para montar o link de redefinição de senha nos e-mails.
PUBLIC_URL=http://localhost:3000

# Configuração de SMTP para envio real de e-mails de redefinição de senha.
# Sem isso, o link de redefinição só é registrado no log do servidor (não é enviado).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
