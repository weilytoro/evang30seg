PORT=3000

# Segredo usado para assinar os tokens JWT. Troque por um valor aleatório forte em produção.
JWT_SECRET=troque-por-um-segredo-forte

# Código exigido para criar uma conta de administrador durante o cadastro.
ADMIN_SIGNUP_CODE=admin2026

# Origem permitida para requisições CORS. Use "*" apenas em desenvolvimento.
CORS_ORIGIN=*
